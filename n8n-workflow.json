{
  "name": "FinTech AI Weekly Publish",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1,4"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "id": "cron-trigger",
      "name": "Weekly Mon/Thu 9AM"
    },
    {
      "parameters": {
        "command": "/bin/bash /home/thor/finAI-website/auto-publish.sh",
        "options": {}
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [500, 300],
      "id": "exec-script",
      "name": "Generate & Publish",
      "credentials": {}
    }
  ],
  "connections": {
    "Weekly Mon/Thu 9AM": {
      "main": [
        [
          {
            "node": "Generate & Publish",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
