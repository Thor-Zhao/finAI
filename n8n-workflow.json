    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1,4"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "name": "Weekly Mon/Thu 9AM"
    },
    {
      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\nconst output = execSync('python3 /home/thor/finAI-website/auto-publish.py', { timeout: 300000, cwd: '/home/thor/finAI-website' });\nreturn [{ json: { stdout: output.toString() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300],
      "name": "Generate & Publish"
    }
  ],
  "connections": {
    "Weekly Mon/Thu 9AM": {
      "main": [
        [
          {
            "node": "Generate & Publish",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
